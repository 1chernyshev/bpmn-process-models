<bpmn:startEvent id="S0" name="Переговоры с поставщиком завершены"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="T1" name="Передать название и телефон поставщика МОЗу"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T2" name="Заполнить карточку поставщика в OM"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="T3" name="Создать карточку поставщика"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:dataObjectReference id="D1" name="Карточка поставщика" dataObjectRef="DO_D1"/><bpmn:dataObject id="DO_D1"/>
<bpmn:userTask id="T4" name="Запросить недостающие данные по телефону"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:userTask>
<bpmn:textAnnotation id="N1"><bpmn:text>Обязательные поля карточки: название, телефон, почта, город, мин. сумма заказа, схема поставки</bpmn:text></bpmn:textAnnotation>
<bpmn:exclusiveGateway id="G1" name="Все обязательные поля заполнены?" default="F7"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T5" name="Указать в поле «Комментарий» причину"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G2" name=""><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T6" name="Исправить или дополнить карточку"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T7" name="Сохранить карточку поставщика"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="T8" name="Отобразить поставщика в разделе согласования НОЗ"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T9" name="Проверить карточку и данные поставщика"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G3" name="Согласовано?" default="F14"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G4" name="Решение МОЗ?" default="F16"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T10" name="Удалить поставщика по согласованию с КМ"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="E1" name="Поставщик отклонен"><bpmn:incoming>F18</bpmn:incoming></bpmn:endEvent>
<bpmn:parallelGateway id="S1" name="Автоматически направить ДПЗ и ДПП"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing><bpmn:outgoing>F20</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="A" name="Подтвердить ознакомление (закупки)"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B" name="Подтвердить ознакомление (продажи)"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="BA" name="3 часа" attachedToRef="A" cancelActivity="false"><bpmn:outgoing>F21</bpmn:outgoing><bpmn:timerEventDefinition id="TED_BA"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="RA" name="Отправить ДПЗ письмо с просьбой подтвердить"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="EA" name="Письмо ДПЗ отправлено"><bpmn:incoming>F22</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="BB" name="3 часа" attachedToRef="B" cancelActivity="false"><bpmn:outgoing>F23</bpmn:outgoing><bpmn:timerEventDefinition id="TED_BB"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="RB" name="Отправить ДПП письмо с просьбой подтвердить"><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="EB" name="Письмо ДПП отправлено"><bpmn:incoming>F24</bpmn:incoming></bpmn:endEvent>
<bpmn:parallelGateway id="J" name=""><bpmn:incoming>F25</bpmn:incoming><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:endEvent id="E2" name="Поставщик добавлен, работа начата"><bpmn:incoming>F27</bpmn:incoming><bpmn:messageEventDefinition id="MED_E2"/></bpmn:endEvent>
