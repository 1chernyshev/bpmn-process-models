<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Pool_App" name="Обработка заявки на нового клиента" processRef="Process_App"/>
</bpmn:collaboration>
<bpmn:process id="Process_App" isExecutable="false">
<bpmn:laneSet id="LaneSet_Process_App">
