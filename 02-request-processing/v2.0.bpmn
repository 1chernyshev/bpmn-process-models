<bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>BT</bpmn:flowNodeRef>
<bpmn:flowNodeRef>R2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>R3</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Клиент пришел в клиентский отдел"><bpmn:outgoing>Fl1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="M1" name="Открыть форму новой заявки в Системе А"><bpmn:incoming>Fl1</bpmn:incoming><bpmn:outgoing>Fl2</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="F1" name="Отобразить форму новой заявки"><bpmn:incoming>Fl2</bpmn:incoming><bpmn:outgoing>Fl3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="M2" name="Внести паспортные данные клиента"><bpmn:incoming>Fl3</bpmn:incoming><bpmn:outgoing>Fl4</bpmn:outgoing></bpmn:userTask>
<bpmn:textAnnotation id="N1"><bpmn:text>Паспорт: серия, номер, дата выдачи, кем выдан</bpmn:text></bpmn:textAnnotation>
<bpmn:userTask id="M3" name="Нажать кнопку «Отправить на проверку»"><bpmn:incoming>Fl4</bpmn:incoming><bpmn:outgoing>Fl5</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="F2" name="Отправить данные на проверку в Систему Б"><bpmn:incoming>Fl5</bpmn:incoming><bpmn:outgoing>Fl6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="B1" name="Создать заявку, статус = На проверке"><bpmn:incoming>Fl6</bpmn:incoming><bpmn:outgoing>Fl7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:dataObjectReference id="D1" name="Заявка на нового клиента" dataObjectRef="DO_D1"/><bpmn:dataObject id="DO_D1"/>
<bpmn:serviceTask id="B2" name="Выполнить проверку клиента"><bpmn:incoming>Fl7</bpmn:incoming><bpmn:outgoing>Fl8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G1" name="Проверка пройдена?" default="Fl10"><bpmn:incoming>Fl8</bpmn:incoming><bpmn:outgoing>Fl9</bpmn:outgoing><bpmn:outgoing>Fl10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="B3" name="Установить статус = Проверка пройдена"><bpmn:incoming>Fl9</bpmn:incoming><bpmn:outgoing>Fl11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="B4" name="Установить статус = Отказ"><bpmn:incoming>Fl10</bpmn:incoming><bpmn:outgoing>Fl12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="F3" name="Отобразить менеджеру одобрение"><bpmn:incoming>Fl11</bpmn:incoming><bpmn:outgoing>Fl14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="M4" name="Внести данные о работе и проживании"><bpmn:incoming>Fl14</bpmn:incoming><bpmn:outgoing>Fl15</bpmn:outgoing></bpmn:userTask>
<bpmn:textAnnotation id="N2"><bpmn:text>Место работы, должность, доход, адрес фактического проживания</bpmn:text></bpmn:textAnnotation>
<bpmn:userTask id="M5" name="Нажать «Перевести на руководителя»"><bpmn:incoming>Fl15</bpmn:incoming><bpmn:outgoing>Fl16</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="F4" name="Отобразить менеджеру отказ"><bpmn:incoming>Fl12</bpmn:incoming><bpmn:outgoing>Fl13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Отказ по заявке"><bpmn:incoming>Fl13</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="F5" name="Отправить заявку на согласование руководителю"><bpmn:incoming>Fl16</bpmn:incoming><bpmn:outgoing>Fl17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="B5" name="Установить статус = На согласовании"><bpmn:incoming>Fl17</bpmn:incoming><bpmn:outgoing>Fl18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="R1" name="Открыть заявку в Системе А"><bpmn:incoming>Fl18</bpmn:incoming><bpmn:outgoing>Fl19</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="BT" name="2 дня" attachedToRef="R1" cancelActivity="true"><bpmn:outgoing>Fl23</bpmn:outgoing><bpmn:timerEventDefinition id="TED_BT"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:userTask id="R2" name="Проверить данные заявки"><bpmn:incoming>Fl19</bpmn:incoming><bpmn:outgoing>Fl20</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="R3" name="Нажать кнопку «Согласовать»"><bpmn:incoming>Fl20</bpmn:incoming><bpmn:outgoing>Fl21</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="F6" name="Отправить согласование в Систему Б"><bpmn:incoming>Fl21</bpmn:incoming><bpmn:outgoing>Fl22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G2" name=""><bpmn:incoming>Fl22</bpmn:incoming><bpmn:incoming>Fl23</bpmn:incoming><bpmn:outgoing>Fl24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="B6" name="Установить статус = Согласована"><bpmn:incoming>Fl24</bpmn:incoming><bpmn:outgoing>Fl25</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Заявка согласована"><bpmn:incoming>Fl25</bpmn:incoming></bpmn:endEvent>
