<bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_A" name="СИСТЕМА А (фронтенд)">
<bpmn:flowNodeRef>F1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>F2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>F3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>F4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>F5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>F6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_B" name="СИСТЕМА Б (бэкенд)">
<bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B5</bpmn:flowNodeRef>
