<bpmn:startEvent id="S0" name="Клиент выбрал товар на сайте"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="C1" name="Оставить заявку на покупку товара"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y1" name="Создать заказ, статус = Новый"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:dataObjectReference id="D1" name="Заказ" dataObjectRef="DO_D1"/><bpmn:dataObject id="DO_D1"/>
<bpmn:serviceTask id="Y2" name="Поставить задачу менеджеру на проверку остатков"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="M1" name="Проверить остатки товара"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="BM" name="12 часов" attachedToRef="M1" cancelActivity="true"><bpmn:outgoing>f5</bpmn:outgoing><bpmn:timerEventDefinition id="TED_BM"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:userTask id="R1" name="Проверить остатки вместо менеджера"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="BR" name="6 часов" attachedToRef="R1" cancelActivity="true"><bpmn:outgoing>f11</bpmn:outgoing><bpmn:timerEventDefinition id="TED_BR"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GM" name=""><bpmn:incoming>f6</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G1" name="Товар в наличии?" default="f10"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="GC" name=""><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Y4" name="Установить статус = Отменен"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Заказ отменен"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Y3" name="Установить статус = Подтвержден"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Y5" name="Показать заказ в личном кабинете клиента"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="C2" name="Выбрать способ получения и оплатить картой"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="B7" name="7 дней" attachedToRef="C2" cancelActivity="true"><bpmn:outgoing>f16</bpmn:outgoing><bpmn:timerEventDefinition id="TED_B7"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="Y6" name="Отменить неоплаченный заказ, статус = Отменен"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="Y7" name="Отправить менеджеру уведомление об отмене"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E2" name="Заказ отменен: не оплачен"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Y8" name="Принять оплату, статус = Оплачен"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G2" name="Способ получения?" default="f22"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:outgoing>f22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="M3" name="Собрать заказ для курьера"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:userTask>
<bpmn:manualTask id="K1" name="Доставить заказ клиенту"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="K2" name="Отметить заказ доставленным"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="M2" name="Собрать заказ для самовывоза"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y9" name="Установить статус = Готов к выдаче"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="C3" name="Забрать заказ в пункте выдачи"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:manualTask>
<bpmn:boundaryEvent id="B30" name="30 дней" attachedToRef="C3" cancelActivity="true"><bpmn:outgoing>f28</bpmn:outgoing><bpmn:timerEventDefinition id="TED_B30"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="Y10" name="Отменить невостребованный заказ без возврата средств"><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="Y11" name="Отправить клиенту SMS об отмене"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E3" name="Заказ отменен: не забран"><bpmn:incoming>f30</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="M4" name="Выдать заказ клиенту"><bpmn:incoming>f31</bpmn:incoming><bpmn:outgoing>f32</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GR" name=""><bpmn:incoming>f25</bpmn:incoming><bpmn:incoming>f32</bpmn:incoming><bpmn:outgoing>f33</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Y12" name="Установить статус = Получен"><bpmn:incoming>f33</bpmn:incoming><bpmn:outgoing>f34</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E4" name="Заказ получен клиентом"><bpmn:incoming>f34</bpmn:incoming><bpmn:messageEventDefinition id="MED_E4"/></bpmn:endEvent>
