<bpmn:startEvent id="S" name="Клиент захотел заказать пиццу"><bpmn:outgoing>P1f</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="C1" name="Открыть приложение и выбрать пиццу с ингредиентами"><bpmn:incoming>P1f</bpmn:incoming><bpmn:outgoing>P2f</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="C2" name="Указать адрес доставки и способ оплаты"><bpmn:incoming>P2f</bpmn:incoming><bpmn:outgoing>P3f</bpmn:outgoing></bpmn:userTask>
<bpmn:textAnnotation id="N1"><bpmn:text>Оплата сразу картой либо по факту получения: карта или наличные</bpmn:text></bpmn:textAnnotation>
<bpmn:userTask id="C3" name="Нажать кнопку «Оформить заказ»"><bpmn:incoming>P3f</bpmn:incoming><bpmn:outgoing>P4f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="A1" name="Отправить заказ в систему учета"><bpmn:incoming>P4f</bpmn:incoming><bpmn:outgoing>P5f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Y1" name="Создать заказ, статус = Новый"><bpmn:incoming>P5f</bpmn:incoming><bpmn:outgoing>P6f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Y2" name="Уведомить администратора о заказе"><bpmn:incoming>P6f</bpmn:incoming><bpmn:outgoing>P7f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="D1" name="Проверить детали заказа и наличие ингредиентов"><bpmn:incoming>P7f</bpmn:incoming><bpmn:outgoing>P8f</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G1" name="Ингредиенты в наличии?" default="P9f"><bpmn:incoming>P8f</bpmn:incoming><bpmn:outgoing>P9f</bpmn:outgoing><bpmn:outgoing>P10f</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="D2" name="Позвонить клиенту и уточнить заказ"><bpmn:incoming>P9f</bpmn:incoming><bpmn:outgoing>P11f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y3" name="Установить статус = На уточнении"><bpmn:incoming>P11f</bpmn:incoming><bpmn:outgoing>P12f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="C4" name="Сообщить решение по заказу"><bpmn:incoming>P12f</bpmn:incoming><bpmn:outgoing>P13f</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="G3" name="Решение клиента?" default="P14f"><bpmn:incoming>P13f</bpmn:incoming><bpmn:outgoing>P14f</bpmn:outgoing><bpmn:outgoing>P15f</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="D3" name="Заменить позиции в заказе"><bpmn:incoming>P14f</bpmn:incoming><bpmn:outgoing>P17f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y4" name="Установить статус = Отменен"><bpmn:incoming>P15f</bpmn:incoming><bpmn:outgoing>P16f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Заказ отменен"><bpmn:incoming>P16f</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="G2" name=""><bpmn:incoming>P10f</bpmn:incoming><bpmn:incoming>P17f</bpmn:incoming><bpmn:outgoing>P18f</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="D4" name="Подтвердить заказ"><bpmn:incoming>P18f</bpmn:incoming><bpmn:outgoing>P19f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y5" name="Установить статус = Подтвержден"><bpmn:incoming>P19f</bpmn:incoming><bpmn:outgoing>P20f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="D5" name="Записать заказ на стикере и передать повару"><bpmn:incoming>P20f</bpmn:incoming><bpmn:outgoing>P21f</bpmn:outgoing></bpmn:manualTask>
<bpmn:textAnnotation id="N2"><bpmn:text>Стикер — бумажный носитель для кухни, в системе не фиксируется</bpmn:text></bpmn:textAnnotation>
<bpmn:userTask id="D6" name="Отметить в системе «Передан на кухню»"><bpmn:incoming>P21f</bpmn:incoming><bpmn:outgoing>P22f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y6" name="Установить статус = Готовится"><bpmn:incoming>P22f</bpmn:incoming><bpmn:outgoing>P23f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="P1" name="Приготовить пиццу и передать администратору"><bpmn:incoming>P23f</bpmn:incoming><bpmn:outgoing>P24f</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="D7" name="Передать заказ курьеру"><bpmn:incoming>P24f</bpmn:incoming><bpmn:outgoing>P25f</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="K1" name="Принять заказ: адрес и время доставки"><bpmn:incoming>P25f</bpmn:incoming><bpmn:outgoing>P26f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y7" name="Установить статус = В доставке"><bpmn:incoming>P26f</bpmn:incoming><bpmn:outgoing>P27f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="K2" name="Доставить заказ клиенту"><bpmn:incoming>P27f</bpmn:incoming><bpmn:outgoing>P28f</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="C5" name="Получить заказ"><bpmn:incoming>P28f</bpmn:incoming><bpmn:outgoing>P29f</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="G4" name="Заказ оплачен?" default="P30f"><bpmn:incoming>P29f</bpmn:incoming><bpmn:outgoing>P30f</bpmn:outgoing><bpmn:outgoing>P31f</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="C7" name="Оплатить заказ курьеру"><bpmn:incoming>P31f</bpmn:incoming><bpmn:outgoing>P32f</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="G5" name=""><bpmn:incoming>P30f</bpmn:incoming><bpmn:incoming>P32f</bpmn:incoming><bpmn:outgoing>P33f</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="C6" name="Забрать чек"><bpmn:incoming>P33f</bpmn:incoming><bpmn:outgoing>P34f</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="K3" name="Сообщить администратору о доставке в Telegram"><bpmn:incoming>P34f</bpmn:incoming><bpmn:outgoing>P35f</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="D8" name="Отметить заказ доставленным"><bpmn:incoming>P35f</bpmn:incoming><bpmn:outgoing>P36f</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Y8" name="Установить статус = Доставлен"><bpmn:incoming>P36f</bpmn:incoming><bpmn:outgoing>P37f</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Заказ доставлен"><bpmn:incoming>P37f</bpmn:incoming><bpmn:messageEventDefinition id="MED_E2"/></bpmn:endEvent>
